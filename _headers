/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/js/*
  Cache-Control: public, max-age=604800

/assets/data/*
  Cache-Control: public, max-age=600
